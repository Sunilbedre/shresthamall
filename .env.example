# Copy this file to .env and fill in real values. Never commit the real .env file.

APP_ENV=production
APP_URL=https://example.com
APP_TIMEZONE=Asia/Kolkata

# Random long random string used for session/CSRF signing. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=change_this_to_a_long_random_string

# Secret admin panel URL path (NOT "admin"). Example login: https://yourdomain.com/sfs-ops-m9k2x7q4/login.php
ADMIN_PATH=sfs-ops-m9k2x7q4

# SQLite database path (relative to project root)
DB_PATH=storage/database.sqlite

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=your_1_special_offer
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_HEADER_IMAGE_URL=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_this_webhook_verify_token

# Optional: Cloudflare Turnstile (spam protection on the public form)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
