# Root .htaccess
# Point your domain's document root at THIS project root folder (not /public).
# This file maps clean URLs to the actual PHP files inside /public and /admin,
# and blocks direct web access to the folders that must never be public.

RewriteEngine On

# ---- Block sensitive files -------------------------------------------------
<FilesMatch "(?i)^(\.env|\.git|composer\.(json|lock)|.*\.(sqlite|db|log|bak|sql))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ---- Block direct access to internal folders -----------------------------
RewriteRule ^(app|config|storage|templates|scripts)(/|$) - [F,L]
RewriteRule (^|/)\.env - [F,L]
RewriteRule (^|/)\.git - [F,L]

# ---- Hide old /admin URL (scanners) ---------------------------------------
RewriteCond %{THE_REQUEST} \s/+admin[/?\s] [NC]
RewriteRule ^ - [R=404,L]

# ---- Public routes (clean + .php aliases used by redirects) ---------------
RewriteRule ^offer/?$ public/offer.php [L]
RewriteRule ^offer\.php$ public/offer.php [L]
RewriteRule ^check-mobile/?$ public/check_mobile.php [L,QSA]
RewriteRule ^check-mobile\.php$ public/check_mobile.php [L,QSA]
RewriteRule ^success/?$ public/success.php [L]
RewriteRule ^success\.php$ public/success.php [L]
RewriteRule ^verify/?$ public/verify.php [L]
RewriteRule ^verify\.php$ public/verify.php [L,QSA]
RewriteRule ^webhook/?$ public/webhook.php [L]
RewriteRule ^webhook\.php$ public/webhook.php [L]
RewriteRule ^voucher-pdf/?$ public/voucher_pdf.php [L,QSA]
RewriteRule ^voucher-pdf\.php$ public/voucher_pdf.php [L,QSA]
RewriteRule ^v/([A-Za-z0-9\-]+)/?$ public/v.php?code=$1 [L,QSA]

# ---- Home page -------------------------------------------------------------
RewriteRule ^$ public/index.php [L]

# ---- Never list directory contents -----------------------------------------
Options -Indexes

# ---- Basic security headers -------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
